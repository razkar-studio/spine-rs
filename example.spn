# Spine full feature showcase!

app
| name = Spine Showcase System
| version = 0.1.0
| mode = production

system
| runtime
| | env = production
| | region = eu-central-1
| | timezone = UTC
|
| limits
| | cpu = 8
| | memory = 16GB
| | io = high
|
| logging
| | level = info
| | format = json
| | sinks
| | | - stdout
| | | - file
| | | | path = "/var/log/spine.log"
| | | | rotation = daily
|
| telemetry
| | enabled = true
| | exporter = otel
| | endpoint = "https://telemetry.local"
|
| tracing
| | enabled = true
| | sampler = always_on
| | exporters
| | | - otlp
| | | - console

database
| primary
| | driver = postgres
| | host = "db.primary.local"
| | port = 5432
| | credentials
| | | user = admin
| | | password = "secret"
| | | auth
| | | | method = scram-sha-256
|
| replicas
| | -
| | | host = "db.replica-1.local"
| | | lag = low
| | | regions
| | | | - eu-central-1
| | | | - eu-west-1
| |
| | -
| | | host = "db.replica-2.local"
| | | lag = medium

features
| auth
| | enabled = true
| | providers
| | | - local
| | | - oauth
| | | | provider = github
| | | | client_id = abc123
|
| caching
| | enabled = true
| | strategy = lru
| | ttl = "300s"
|
| analytics
| | enabled = true
| | query = """
| | SELECT user_id, COUNT(*)
| | FROM events
| | WHERE active = true
| | GROUP BY user_id
| | ORDER BY COUNT(*) DESC
| | """
|
| flags
| | -
| | | name = new-ui
| | | enabled = true
| | | rollout = 0.5
| | -
| | | name = dark-mode
| | | enabled = true
| | | rollout = 1.0

deploy
| strategy = rolling
| replicas = 3
| rollback
| | enabled = true
| | threshold = 2
| | window = "60s"

plugins
| -
| | name = logger
| | enabled = true
| |
| -
| | name = metrics
| | enabled = true
| |
| -
| | name = tracer
| | enabled = false

meta
| created = std.date"2026-05-26"
| hash = base64"c3BpbmUtZnVsbC1leGFtcGxl"
| tags
| | - core
| | - production
| | - showcase
| | - append-demo
|
| history
| | notes = """
| | Spine evolves through real usage.
| | Structure is explicit, and spacing is meaningful.
| | """
|
| ~events
| | type = created
| | timestamp = "2026-05-26T00:00:00Z"
|
| ~events
| | type = updated
| | timestamp = "2026-05-26T12:00:00Z"
|
| ~events
| | type = deployed
| | timestamp = "2026-05-26T18:00:00Z"
