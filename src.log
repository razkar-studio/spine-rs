  87 │     fn parse_statement(
  88 │         &mut self,
  89 │         fields: &mut Vec<(String, Value)>,
  90 │         spans: &mut Spans,
  91 │         depth: usize,
  92 │     ) {
  93 │         if self.current_depth() < depth {
  94 │             return;
  95 │         }
  96 │         self.consume_pipes(depth);
  97 │ 
  98 │         match self.peek().cloned() {
  99 │             Some(Token::Tilde) => {
 100 │                 let (line, col) = self.peek_span().unwrap_or((0, 0));
 101 │                 self.advance();
 102 │                 self.parse_append(fields, spans, depth, line, col);
 103 │             }
 104 │             Some(Token::Ident(name)) => {
 105 │                 let (line, col) = self.peek_span().unwrap_or((0, 0));
 106 │                 self.advance();
 107 │                 self.parse_ident(name, fields, spans, depth, line, col);
 108 │             }
 109 │             _ => {
 110 │                 self.advance();
 111 │             }
 112 │         }
 113 │     }
 114 │ 
 115 │     fn parse_ident(
 116 │         &mut self,
 117 │         name: String,
 118 │         fields: &mut Vec<(String, Value)>,
 119 │         spans: &mut Spans,
 120 │         depth: usize,
 121 │         line: usize,
 122 │         col: usize,
 123 │     ) {
 124 │         match self.peek().cloned() {
 125 │             Some(Token::Dot) => {
 126 │                 self.advance();
 127 │                 if let Some(Token::Ident(next)) = self.peek().cloned() {
 128 │                     self.advance();
 129 │                     let mut child_fields = Vec::new();
 130 │                     let mut child_spans = Spans::new();
 131 │                     self.parse_ident(next, &mut child_fields, &mut child_spans, depth, line, col);
 132 │                     self.merge_into(
 133 │                         fields,
 134 │                         spans,
 135 │                         name,
 136 │                         Value::Object(child_fields),
 137 │                         line,
 138 │                         col,
 139 │                         depth,
 140 │                     );
 141 │                 }
 142 │             }
 143 │             Some(Token::Equals) => {
 144 │                 self.advance();
 145 │                 let value = self.parse_value();
 146 │                 self.skip_newlines();
 147 │                 self.merge_into(fields, spans, name, value, line, col, depth);
 148 │             }
 149 │             Some(Token::Newline) | None => {
 150 │                 self.skip_newlines();
 151 │ 
 152 │                 let is_array = self.is_array_block(depth + 1);
 153 │ 
 154 │                 if is_array {
 155 │                     let mut entries = Vec::new();
 156 │                     while self.current_depth() == depth + 1 {
 157 │                         self.consume_pipes(depth + 1);
 158 │                         match self.peek().cloned() {
 159 │                             Some(Token::Dash) => {
 160 │                                 self.advance();
 161 │                                 self.skip_newlines();
 162 │ 
 163 │                                 if self.current_depth() == depth + 2 {
 164 │                                     let mut child_fields = Vec::new();
 165 │                                     let mut child_spans = Spans::new();
 166 │                                     while self.current_depth() == depth + 2 {
 167 │                                         self.parse_statement(
 168 │                                             &mut child_fields,
 169 │                                             &mut child_spans,
 170 │                                             depth + 2,
 171 │                                         );
 172 │                                         self.skip_comments_and_newlines();
 173 │                                     }
 174 │                                     entries.push(Value::Object(child_fields));
 175 │                                 } else {
 176 │                                     match self.peek().cloned() {
 177 │                                         Some(Token::Newline) | None => entries.push(Value::Null),
 178 │                                         Some(Token::Ident(name)) => {
 179 │                                             let (line, col) = self.peek_span().unwrap_or((0, 0));
 180 │                                             self.advance();
 181 │ 
 182 │                                             let has_children = match self.peek() {
 183 │                                                 Some(Token::Equals | Token::Dot) => true,
 184 │                                                 Some(Token::Newline) | None => {
 185 │                                                     let mut lookahead = self.pos;
 186 │                                                     while let Some((
 187 │                                                         Token::Newline
 188 │                                                         | Token::LineComment(_)
 189 │                                                         | Token::BlockComment(_),
 190 │                                                         _,
 191 │                                                         _,
 192 │                                                     )) = self.tokens.get(lookahead)
 193 │                                                     {
 194 │                                                         lookahead += 1;
 195 │                                                     }
 196 │                                                     let mut next_depth = 0;
 197 │                                                     while let Some((Token::Pipe, _, _)) =
 198 │                                                         self.tokens.get(lookahead)
 199 │                                                     {
 200 │                                                         next_depth += 1;
 201 │                                                         lookahead += 1;
 202 │                                                     }
 203 │                                                     next_depth == depth + 2
 204 │                                                 }
 205 │                                                 _ => false,
 206 │                                             };
 207 │ 
 208 │                                             if has_children {
 209 │                                                 let mut temp_fields = Vec::new();
 210 │                                                 let mut temp_spans = Spans::new();
 211 │                                                 self.parse_ident(
 212 │                                                     name,
 213 │                                                     &mut temp_fields,
 214 │                                                     &mut temp_spans,
 215 │                                                     depth + 1,
 216 │                                                     line,
 217 │                                                     col,
 218 │                                                 );
 219 │                                                 entries.push(Value::Object(temp_fields));
 220 │                                             } else {
 221 │                                                 entries.push(Value::String(name));
 222 │                                             }
 223 │                                         }
 224 │                                         _ => {
 225 │                                             let v = self.parse_value();
 226 │                                             entries.push(v);
 227 │                                         }
 228 │                                     }
 229 │                                 }
 230 │                             }
 231 │                             Some(Token::Newline) => {
 232 │                                 self.advance();
 233 │                                 self.skip_comments_and_newlines();
 234 │                                 continue;
 235 │                             }
 236 │                             _ => break,
 237 │                         }
 238 │                         self.skip_comments_and_newlines();
 239 │                     }
 240 │                     self.merge_into(fields, spans, name, Value::Array(entries), line, col, depth);
 241 │                 } else {
 242 │                     let mut child_fields = Vec::new();
 243 │                     let mut child_spans = Spans::new();
 244 │                     while self.current_depth() == depth + 1 {
 245 │                         self.parse_statement(&mut child_fields, &mut child_spans, depth + 1);
 246 │                         self.skip_comments_and_newlines();
 247 │                     }
 248 │                     self.merge_into(
 249 │                         fields,
 250 │                         spans,
 251 │                         name,
 252 │                         Value::Object(child_fields),
 253 │                         line,
 254 │                         col,
 255 │                         depth,
 256 │                     );
 257 │                 }
 258 │             }
 259 │             _ => {}
 260 │         }
 261 │     }
