  71 │     fn current_depth(&self) -> usize {
  72 │         let mut depth = 0;
  73 │         let mut lookahead = self.pos;
  74 │         while let Some((Token::Pipe, _, _)) = self.tokens.get(lookahead) {
  75 │             depth += 1;
  76 │             lookahead += 1;
  77 │         }
  78 │         depth
  79 │     }
