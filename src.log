   1 │ use crate::{SpannedToken, Token};
   2 │ 
   3 │ pub struct Lexer {
   4 │     input: Vec<char>,
   5 │     pos: usize,
   6 │     line_pipes: usize,
   7 │     line: usize,
   8 │     col: usize,
   9 │     after_value_start: bool,
  10 │ }
  11 │ 
  12 │ impl Lexer {
  13 │     #[must_use]
  14 │     pub fn new(input: &str) -> Self {
  15 │         Self {
  16 │             input: input.chars().collect(),
  17 │             pos: 0,
  18 │             line_pipes: 0,
  19 │             line: 1,
  20 │             col: 1,
  21 │             after_value_start: false,
  22 │         }
  23 │     }
  24 │ 
  25 │     fn peek(&self) -> Option<char> {
  26 │         self.input.get(self.pos).copied()
  27 │     }
  28 │ 
  29 │     fn advance(&mut self) -> Option<char> {
  30 │         let c = self.input.get(self.pos).copied();
  31 │         self.pos += 1;
  32 │         match c {
  33 │             Some('\n') => {
  34 │                 self.line += 1;
  35 │                 self.col = 1;
  36 │             }
  37 │             Some(_) => {
  38 │                 self.col += 1;
  39 │             }
  40 │             None => {}
  41 │         }
  42 │         c
  43 │     }
  44 │ 
  45 │     const fn is_at_end(&self) -> bool {
  46 │         self.pos >= self.input.len()
  47 │     }
  48 │ 
  49 │     fn skip_line_comment(&mut self) -> Token {
  50 │         self.advance();
  51 │         let mut content = String::new();
  52 │         while let Some(c) = self.peek() {
  53 │             if c == '\n' {
  54 │                 break;
  55 │             }
  56 │             content.push(c);
  57 │             self.advance();
  58 │         }
  59 │         Token::LineComment(content.trim().to_string())
  60 │     }
  61 │ 
  62 │     fn skip_block_comment(&mut self) -> Token {
  63 │         let start_line = self.line;
  64 │         let start_col = self.col;
  65 │         self.advance();
  66 │         self.advance();
  67 │         let mut content = String::new();
  68 │         let mut depth = 1;
  69 │         while !self.is_at_end() {
  70 │             match (self.peek(), self.input.get(self.pos + 1).copied()) {
  71 │                 (Some('/'), Some('*')) => {
  72 │                     depth += 1;
  73 │                     content.push_str("/*");
  74 │                     self.advance();
  75 │                     self.advance();
  76 │                 }
  77 │                 (Some('*'), Some('/')) => {
  78 │                     depth -= 1;
  79 │                     self.advance();
  80 │                     self.advance();
  81 │                     if depth == 0 {
  82 │                         return Token::BlockComment(content.trim().to_string());
  83 │                     }
  84 │                     content.push_str("*/");
  85 │                 }
  86 │                 #[allow(unused_assignments)]
  87 │                 (Some(c), _) => {
  88 │                     content.push(c);
  89 │                     self.advance();
  90 │                 }
  91 │                 _ => break,
  92 │             }
  93 │         }
  94 │         Token::Error(format!(
  95 │             "{start_line}:{start_col} unterminated block comment"
  96 │         ))
  97 │     }
  98 │ 
  99 │     fn lex_string(&mut self) -> Token {
 100 │         self.after_value_start = false;
 101 │         let start_line = self.line;
 102 │         let start_col = self.col;
 103 │         self.advance();
 104 │ 
 105 │         if self.peek() == Some('"') {
 106 │             self.advance();
 107 │             if self.peek() == Some('"') {
 108 │                 self.advance();
 109 │                 return self.lex_multiline_string();
 110 │             }
 111 │             return Token::Str(String::new());
 112 │         }
 113 │ 
 114 │         let mut s = String::new();
 115 │         while let Some(c) = self.peek() {
 116 │             match c {
 117 │                 '"' => {
 118 │                     self.advance();
 119 │                     return Token::Str(s);
 120 │                 }
 121 │                 '\n' => {
 122 │                     return Token::Error(format!("{start_line}:{start_col} unterminated string"));
 123 │                 }
 124 │                 '\\' => {
 125 │                     self.advance();
 126 │                     match self.advance() {
 127 │                         Some('n') => s.push('\n'),
 128 │                         Some('t') => s.push('\t'),
 129 │                         Some('\\') => s.push('\\'),
 130 │                         Some('"') => s.push('"'),
 131 │                         _ => {}
 132 │                     }
 133 │                 }
 134 │                 _ => {
 135 │                     s.push(c);
 136 │                     self.advance();
 137 │                 }
 138 │             }
 139 │         }
 140 │         Token::Error(format!("{start_line}:{start_col} unterminated string"))
 141 │     }
 142 │ 
 143 │     fn lex_multiline_string(&mut self) -> Token {
 144 │         let depth = self.line_pipes;
 145 │         let start_line = self.line;
 146 │         let start_col = self.col;
 147 │ 
 148 │         while let Some(c) = self.peek() {
 149 │             if c == '\n' {
 150 │                 self.advance();
 151 │                 break;
 152 │             }
 153 │             self.advance();
 154 │         }
 155 │ 
 156 │         let mut lines = Vec::new();
 157 │ 
 158 │         loop {
 159 │             if self.is_at_end() {
 160 │                 return Token::Error(format!(
 161 │                     "{start_line}:{start_col} unterminated multiline string"
 162 │                 ));
 163 │             }
 164 │ 
 165 │             let saved = self.pos;
 166 │ 
 167 │             let mut pipes = 0;
 168 │             while let Some(c) = self.peek() {
 169 │                 if c == ' ' || c == '\t' {
 170 │                     self.advance();
 171 │                 } else if c == '|' && pipes < depth {
 172 │                     pipes += 1;
 173 │                     self.advance();
 174 │                 } else {
 175 │                     break;
 176 │                 }
 177 │             }
 178 │             if self.peek() == Some(' ') {
 179 │                 self.advance();
 180 │             }
 181 │ 
 182 │             if self.peek() == Some('"')
 183 │                 && self.input.get(self.pos + 1).copied() == Some('"')
 184 │                 && self.input.get(self.pos + 2).copied() == Some('"')
 185 │             {
 186 │                 self.advance();
 187 │                 self.advance();
 188 │                 self.advance();
 189 │                 break;
 190 │             }
 191 │ 
 192 │             self.pos = saved;
 193 │             let mut line = String::new();
 194 │             while let Some(c) = self.peek() {
 195 │                 if c == '\n' {
 196 │                     self.advance();
 197 │                     break;
 198 │                 }
 199 │                 line.push(c);
 200 │                 self.advance();
 201 │             }
 202 │ 
 203 │             let stripped = strip_leading_pipes(&line, depth);
 204 │             lines.push(stripped);
 205 │         }
 206 │ 
 207 │         Token::Str(lines.join("\n"))
 208 │     }
 209 │ 
 210 │     fn lex_number(&mut self) -> Token {
 211 │         let mut s = String::new();
 212 │         while let Some(c) = self.peek() {
 213 │             if c.is_ascii_digit() || c == '.' {
 214 │                 s.push(c);
 215 │                 self.advance();
 216 │             } else {
 217 │                 break;
 218 │             }
 219 │         }
 220 │ 
 221 │         if self.after_value_start {
 222 │             while let Some(c) = self.peek() {
 223 │                 if c == '\n' || c == '#' {
 224 │                     break;
 225 │                 }
 226 │                 s.push(c);
 227 │                 self.advance();
 228 │             }
 229 │             self.after_value_start = false;
 230 │             return Token::Str(s.trim_end().to_string());
 231 │         }
 232 │ 
 233 │         if let Some(c) = self.peek()
 234 │             && c.is_alphabetic()
 235 │         {
 236 │             while let Some(c) = self.peek() {
 237 │                 if c.is_alphanumeric() {
 238 │                     s.push(c);
 239 │                     self.advance();
 240 │                 } else {
 241 │                     break;
 242 │                 }
 243 │             }
 244 │             return Token::Str(s);
 245 │         }
 246 │ 
 247 │         Token::Number(s.parse().unwrap_or(0.0))
 248 │     }
 249 │ 
 250 │     fn lex_ident_or_keyword(&mut self) -> Token {
 251 │         let mut s = String::new();
 252 │         while let Some(c) = self.peek() {
 253 │             if c.is_alphanumeric() || c == '_' || c == '-' {
 254 │                 s.push(c);
 255 │                 self.advance();
 256 │             } else {
 257 │                 break;
 258 │             }
 259 │         }
 260 │ 
 261 │         if self.peek() == Some('"') {
 262 │             self.advance();
 263 │             let mut content = String::new();
 264 │             while let Some(c) = self.peek() {
 265 │                 if c == '"' {
 266 │                     self.advance();
 267 │                     break;
 268 │                 }
 269 │                 content.push(c);
 270 │                 self.advance();
 271 │             }
 272 │             return Token::Tagged(s, content);
 273 │         }
 274 │ 
 275 │         if self.peek() == Some('.')
 276 │             && let Some(&next) = self.input.get(self.pos + 1)
 277 │             && next.is_alphabetic()
 278 │         {
 279 │             let mut lookahead = self.pos + 1;
 280 │             while let Some(&c) = self.input.get(lookahead) {
 281 │                 if c.is_alphanumeric() || c == '_' || c == '-' {
 282 │                     lookahead += 1;
 283 │                 } else {
 284 │                     break;
 285 │                 }
 286 │             }
 287 │             if self.input.get(lookahead) == Some(&'"') {
 288 │                 self.advance();
 289 │                 let mut tag_suffix = String::new();
 290 │                 while let Some(c) = self.peek() {
 291 │                     if c.is_alphanumeric() || c == '_' || c == '-' {
 292 │                         tag_suffix.push(c);
 293 │                         self.advance();
 294 │                     } else {
 295 │                         break;
 296 │                     }
 297 │                 }
 298 │                 let full_tag = format!("{s}.{tag_suffix}");
 299 │                 self.advance();
 300 │                 let mut content = String::new();
 301 │                 while let Some(c) = self.peek() {
 302 │                     if c == '"' {
 303 │                         self.advance();
 304 │                         break;
 305 │                     }
 306 │                     content.push(c);
 307 │                     self.advance();
 308 │                 }
 309 │                 return Token::Tagged(full_tag, content);
 310 │             }
 311 │         }
 312 │ 
 313 │         if self.after_value_start {
 314 │             while let Some(c) = self.peek() {
 315 │                 if c == '\n' || c == '#' {
 316 │                     break;
 317 │                 }
 318 │                 s.push(c);
 319 │                 self.advance();
 320 │             }
 321 │             self.after_value_start = false;
 322 │             return Token::Str(s.trim_end().to_string());
 323 │         }
 324 │ 
 325 │         match s.as_str() {
 326 │             "true" => Token::Bool(true),
 327 │             "false" => Token::Bool(false),
 328 │             "null" => Token::Null,
 329 │             _ => Token::Ident(s),
 330 │         }
 331 │     }
