 335 │ pub unsafe extern "C" fn spine_free_value(val: *mut SpineValue) {
 336 │     if !val.is_null() {
 337 │         unsafe {
 338 │             drop(Box::from_raw(val));
 339 │         }
 340 │     }
 341 │ }
 342 │ 
 343 │ /// # Safety
 344 │ ///
 345 │ /// `s` must be a valid pointer to a C string allocated by Spine, or null.
 346 │ #[unsafe(no_mangle)]
 347 │ pub unsafe extern "C" fn spine_free_string(s: *mut c_char) {
 348 │     if !s.is_null() {
 349 │         unsafe {
 350 │             drop(CString::from_raw(s));
 351 │         }
 352 │     }
 353 │ }
