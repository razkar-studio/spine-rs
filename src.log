 211 │ #[test]
 212 │ fn test_bare_strings_in_array() {
 213 │     let src = "regions\n| - eu-central-1\n| - eu-west-1\n| - us-east-1\n";
 214 │     let tokens = Lexer::new(src).tokenize();
 215 │     let value = Parser::new(tokens, src).parse().expect("parse failed");
 216 │     println!("{value:?}");
 217 │     if let Value::Object(fields) = value {
 218 │         if let Value::Array(arr) = &fields[0].1 {
 219 │             for (i, v) in arr.iter().enumerate() {
 220 │                 println!("[{i}] = {v:?}");
 221 │             }
 222 │             assert_eq!(arr[0], Value::String("eu-central-1".to_string()));
 223 │             assert_eq!(arr[1], Value::String("eu-west-1".to_string()));
 224 │             assert_eq!(arr[2], Value::String("us-east-1".to_string()));
 225 │         } else {
 226 │             panic!("expected array");
 227 │         }
 228 │     } else {
 229 │         panic!("expected object");
 230 │     }
 231 │ }
