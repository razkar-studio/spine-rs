   9 │ pub struct Document {
  10 │     ptr: *mut ffi::SpineDoc,
  11 │ }
  12 │ 
  13 │ #[derive(Debug)]
  14 │ pub enum DocError {
  15 │     Io(std::io::Error),
  16 │     Parse(Vec<String>),
  17 │ }
  18 │ 
  19 │ impl From<std::io::Error> for DocError {
  20 │     fn from(e: std::io::Error) -> Self {
  21 │         Self::Io(e)
  22 │     }
  23 │ }
  24 │ 
  25 │ impl From<Vec<String>> for DocError {
  26 │     fn from(e: Vec<String>) -> Self {
  27 │         Self::Parse(e)
  28 │     }
  29 │ }
  30 │ 
  31 │ impl std::fmt::Debug for Document {
  32 │     fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
  33 │         write!(f, "Document")
  34 │     }
  35 │ }
  36 │ 
  37 │ impl Document {
  38 │     fn from_ptr(ptr: *mut ffi::SpineDoc) -> Result<Self, DocError> {
  39 │         if ptr.is_null() {
  40 │             return Err(DocError::Parse(vec![
  41 │                 "spine_parse returned null".to_string(),
  42 │             ]));
  43 │         }
  44 │         let doc = Self { ptr };
  45 │         if unsafe { ffi::spine_has_errors(ptr) } {
  46 │             let err_ptr = unsafe { ffi::spine_get_errors(ptr) };
  47 │             let errors = if err_ptr.is_null() {
  48 │                 vec!["unknown parse error".to_string()]
  49 │             } else {
  50 │                 let s = unsafe { CStr::from_ptr(err_ptr) }
  51 │                     .to_string_lossy()
  52 │                     .into_owned();
  53 │                 unsafe {
  54 │                     ffi::spine_free_string(err_ptr);
  55 │                 }
  56 │                 return Err(DocError::Parse(vec![s]));
  57 │             };
  58 │             return Err(DocError::Parse(errors));
  59 │         }
  60 │         Ok(doc)
  61 │     }
  62 │ 
  63 │     #[must_use]
  64 │     pub fn from_str_or_panic(input: impl Into<String>) -> Self {
  65 │         Self::from_str(input).unwrap_or_else(|errors| {
  66 │             match &errors {
  67 │                 DocError::Parse(errs) => {
  68 │                     for e in errs {
  69 │                         println!("{e}");
  70 │                     }
  71 │                 }
  72 │                 DocError::Io(e) => {
  73 │                     println!("{e}");
  74 │                 }
  75 │             }
  76 │             std::process::exit(1)
  77 │         })
  78 │     }
  79 │ 
  80 │     /// Loads a Spine document from a file path.
  81 │     ///
  82 │     /// # Errors
  83 │     ///
  84 │     /// Returns a `DocError` if the file cannot be read or the content is invalid.
  85 │     pub fn from_path(path: impl Into<PathBuf>) -> Result<Self, DocError> {
  86 │         let path = path.into();
  87 │         let contents = fs::read_to_string(&path)?;
  88 │         let c_input =
  89 │             CString::new(contents).map_err(|_| vec!["invalid input string".to_string()])?;
  90 │         let filename = path.to_string_lossy();
  91 │         let c_filename = CString::new(filename.as_ref()).ok();
  92 │         let ptr = unsafe {
  93 │             ffi::spine_parse_named(
  94 │                 c_input.as_ptr(),
  95 │                 c_filename.as_ref().map_or(std::ptr::null(), |f| f.as_ptr()),
  96 │             )
  97 │         };
  98 │         Self::from_ptr(ptr)
  99 │     }
 100 │ 
 101 │     /// Parses a Spine document from a string.
 102 │     ///
 103 │     /// # Errors
 104 │     ///
 105 │     /// Returns a `DocError` if the string contains a null byte or the content is invalid.
 106 │     #[allow(clippy::should_implement_trait)]
 107 │     pub fn from_str(input: impl Into<String>) -> Result<Self, DocError> {
 108 │         let input = input.into();
 109 │         let c_input = CString::new(input).map_err(|_| vec!["invalid input string".to_string()])?;
 110 │         let ptr = unsafe { ffi::spine_parse(c_input.as_ptr()) };
 111 │         Self::from_ptr(ptr)
 112 │     }
 113 │ 
 114 │     #[must_use]
 115 │     pub fn root(&self) -> Option<Value> {
 116 │         let ptr = unsafe { ffi::spine_doc_root(self.ptr) };
 117 │         Value::from_ptr(ptr)
 118 │     }
 119 │ }
