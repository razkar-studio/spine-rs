 323 │ pub unsafe extern "C" fn spine_free_doc(doc: *mut SpineDoc) {
 324 │     if !doc.is_null() {
 325 │         unsafe {
 326 │             drop(Box::from_raw(doc));
 327 │         }
 328 │     }
 329 │ }
