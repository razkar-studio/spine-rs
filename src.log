 224 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 225 │ #[unsafe(no_mangle)]
 226 │ pub const unsafe extern "C" fn spine_array_len(val: *const SpineValue) -> c_ulong {
 227 │     if val.is_null() {
 228 │         return 0;
 229 │     }
 230 │     match unsafe { &*(*val).inner } {
 231 │         Value::Array(arr) => arr.len() as c_ulong,
 232 │         _ => 0,
 233 │     }
 234 │ }
 235 │ 
 236 │ /// # Safety
 237 │ ///
 238 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 239 │ #[unsafe(no_mangle)]
 240 │ pub unsafe extern "C" fn spine_array_get(
 241 │     val: *const SpineValue,
 242 │     index: c_ulong,
 243 │ ) -> *const SpineValue {
 244 │     if val.is_null() {
 245 │         return std::ptr::null();
 246 │     }
 247 │     match unsafe { &*(*val).inner } {
 248 │         Value::Array(arr) => arr
 249 │             .get(usize::try_from(index).unwrap_or(usize::MAX))
 250 │             .map_or(std::ptr::null(), |v| {
 251 │                 Box::into_raw(Box::new(SpineValue {
 252 │                     inner: std::ptr::from_ref::<Value>(v),
 253 │                 }))
 254 │             }),
 255 │         _ => std::ptr::null(),
 256 │     }
 257 │ }
 258 │ 
 259 │ /// # Safety
 260 │ ///
 261 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 262 │ #[unsafe(no_mangle)]
 263 │ pub const unsafe extern "C" fn spine_object_len(val: *const SpineValue) -> c_ulong {
 264 │     if val.is_null() {
 265 │         return 0;
 266 │     }
 267 │     match unsafe { &*(*val).inner } {
 268 │         Value::Object(fields) => fields.len() as c_ulong,
 269 │         _ => 0,
 270 │     }
 271 │ }
 272 │ 
 273 │ /// # Safety
 274 │ ///
 275 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 276 │ #[unsafe(no_mangle)]
 277 │ pub unsafe extern "C" fn spine_object_key(val: *const SpineValue, index: c_ulong) -> *mut c_char {
 278 │     if val.is_null() {
 279 │         return std::ptr::null_mut();
 280 │     }
 281 │     match unsafe { &*(*val).inner } {
 282 │         Value::Object(fields) => fields
 283 │             .get(usize::try_from(index).unwrap_or(usize::MAX))
 284 │             .and_then(|(k, _)| CString::new(k.as_str()).ok())
 285 │             .map_or(std::ptr::null_mut(), CString::into_raw),
 286 │         _ => std::ptr::null_mut(),
 287 │     }
 288 │ }
 289 │ 
 290 │ /// # Safety
 291 │ ///
 292 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 293 │ /// `key` must be a valid null-terminated C string.
 294 │ #[unsafe(no_mangle)]
 295 │ pub unsafe extern "C" fn spine_object_get(
 296 │     val: *const SpineValue,
 297 │     key: *const c_char,
 298 │ ) -> *const SpineValue {
 299 │     if val.is_null() || key.is_null() {
 300 │         return std::ptr::null();
 301 │     }
 302 │     let key_str = unsafe { CStr::from_ptr(key) };
 303 │     let Ok(key_str) = key_str.to_str() else {
 304 │         return std::ptr::null();
 305 │     };
 306 │     match unsafe { &*(*val).inner } {
 307 │         Value::Object(fields) => match fields.iter().find(|(k, _)| k == key_str) {
 308 │             Some((_, v)) => Box::into_raw(Box::new(SpineValue {
 309 │                 inner: std::ptr::from_ref::<Value>(v),
 310 │             })),
 311 │             None => std::ptr::null(),
 312 │         },
 313 │         _ => std::ptr::null(),
 314 │     }
 315 │ }
