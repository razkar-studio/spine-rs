  57 │     fn skip_newlines(&mut self) {
  58 │         while self.peek() == Some(&Token::Newline) {
  59 │             self.advance();
  60 │         }
  61 │     }
  62 │ 
  63 │     fn skip_comments_and_newlines(&mut self) {
  64 │         while let Some(Token::Newline | Token::LineComment(_) | Token::BlockComment(_)) =
  65 │             self.peek()
  66 │         {
  67 │             self.advance();
  68 │         }
  69 │     }
