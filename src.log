   1 │ use spine_rs::{Lexer, Parser, Value};
   2 │ use std::ffi::{CStr, CString};
   3 │ use std::os::raw::{c_char, c_double, c_int, c_ulong};
   4 │ 
   5 │ /// Opaque types that C sees as pointers
   6 │ pub struct SpineDoc {
   7 │     root: Option<Value>,
   8 │     errors: Vec<String>,
   9 │ }
  10 │ 
  11 │ pub struct SpineValue {
  12 │     inner: *const Value,
  13 │ }
  14 │ 
  15 │ /// # Safety
  16 │ ///
  17 │ /// `input` must be a valid null-terminated C string.
  18 │ #[unsafe(no_mangle)]
  19 │ pub unsafe extern "C" fn spine_parse(input: *const c_char) -> *mut SpineDoc {
  20 │     if input.is_null() {
  21 │         return std::ptr::null_mut();
  22 │     }
  23 │ 
  24 │     let c_str = unsafe { CStr::from_ptr(input) };
  25 │     let Ok(src) = c_str.to_str() else {
  26 │         return std::ptr::null_mut();
  27 │     };
  28 │ 
  29 │     let tokens = Lexer::new(src).tokenize();
  30 │     let mut parser = Parser::new(tokens, src);
  31 │     let result = parser.parse();
  32 │ 
  33 │     let doc = match result {
  34 │         Ok(value) => SpineDoc {
  35 │             root: Some(value),
  36 │             errors: Vec::new(),
  37 │         },
  38 │         Err(errors) => SpineDoc { root: None, errors },
  39 │     };
  40 │ 
  41 │     Box::into_raw(Box::new(doc))
  42 │ }
  43 │ 
  44 │ /// Parses Spine source with an associated filename for error messages.
  45 │ ///
  46 │ /// # Safety
  47 │ ///
  48 │ /// `input` must be a valid null-terminated C string.
  49 │ /// `filename` must be a valid null-terminated C string, or null.
  50 │ #[unsafe(no_mangle)]
  51 │ pub unsafe extern "C" fn spine_parse_named(
  52 │     input: *const c_char,
  53 │     filename: *const c_char,
  54 │ ) -> *mut SpineDoc {
  55 │     if input.is_null() {
  56 │         return std::ptr::null_mut();
  57 │     }
  58 │ 
  59 │     let c_str = unsafe { CStr::from_ptr(input) };
  60 │     let Ok(src) = c_str.to_str() else {
  61 │         return std::ptr::null_mut();
  62 │     };
  63 │ 
  64 │     let tokens = Lexer::new(src).tokenize();
  65 │     let mut parser = Parser::new(tokens, src);
  66 │ 
  67 │     if !filename.is_null() {
  68 │         let fname_cstr = unsafe { CStr::from_ptr(filename) };
  69 │         if let Ok(fname) = fname_cstr.to_str() {
  70 │             parser = parser.with_source(fname);
  71 │         }
  72 │     }
  73 │ 
  74 │     let result = parser.parse();
  75 │ 
  76 │     let doc = match result {
  77 │         Ok(value) => SpineDoc {
  78 │             root: Some(value),
  79 │             errors: Vec::new(),
  80 │         },
  81 │         Err(errors) => SpineDoc { root: None, errors },
  82 │     };
  83 │ 
  84 │     Box::into_raw(Box::new(doc))
  85 │ }
  86 │ 
  87 │ /// # Safety
  88 │ ///
  89 │ /// `doc` must be a valid pointer to a `SpineDoc` or null.
  90 │ #[unsafe(no_mangle)]
  91 │ pub const unsafe extern "C" fn spine_has_errors(doc: *const SpineDoc) -> bool {
  92 │     if doc.is_null() {
  93 │         return true;
  94 │     }
  95 │     !unsafe { (*doc).errors.is_empty() }
  96 │ }
  97 │ 
  98 │ /// # Safety
  99 │ ///
 100 │ /// `doc` must be a valid pointer to a `SpineDoc` or null.
 101 │ #[unsafe(no_mangle)]
 102 │ pub unsafe extern "C" fn spine_get_errors(doc: *const SpineDoc) -> *mut c_char {
 103 │     if doc.is_null() {
 104 │         return std::ptr::null_mut();
 105 │     }
 106 │     let errors = unsafe { (*doc).errors.join("") };
 107 │     CString::new(errors).map_or(std::ptr::null_mut(), CString::into_raw)
 108 │ }
