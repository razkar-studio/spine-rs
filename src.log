 263 │     fn is_array_block(&self, depth: usize) -> bool {
 264 │         let mut i = self.pos;
 265 │         let mut pipes = 0;
 266 │         while let Some((Token::Pipe, _, _)) = self.tokens.get(i) {
 267 │             pipes += 1;
 268 │             i += 1;
 269 │         }
 270 │         if pipes != depth {
 271 │             return false;
 272 │         }
 273 │         matches!(self.tokens.get(i), Some((Token::Dash, _, _)))
 274 │     }
 275 │ 
 276 │     fn parse_value(&mut self) -> Value {
 277 │         match self.peek().cloned() {
 278 │             Some(Token::Str(s) | Token::Ident(s)) => {
 279 │                 self.advance();
 280 │                 Value::String(s)
 281 │             }
 282 │             Some(Token::Number(n)) => {
 283 │                 self.advance();
 284 │                 Value::Number(n)
 285 │             }
 286 │             Some(Token::Bool(b)) => {
 287 │                 self.advance();
 288 │                 Value::Bool(b)
 289 │             }
 290 │             Some(Token::Null) => {
 291 │                 self.advance();
 292 │                 Value::Null
 293 │             }
 294 │             Some(Token::Tagged(tag, content)) => {
 295 │                 self.advance();
 296 │                 Value::Tagged(tag, content)
 297 │             }
 298 │             _ => Value::Null,
 299 │         }
 300 │     }
 301 │ 
 302 │     fn parse_append(
 303 │         &mut self,
 304 │         fields: &mut Vec<(String, Value)>,
 305 │         spans: &mut Spans,
 306 │         depth: usize,
 307 │         tilde_line: usize,
 308 │         tilde_col: usize,
 309 │     ) {
 310 │         let mut path = Vec::new();
 311 │         if let Some(Token::Ident(name)) = self.peek().cloned() {
 312 │             self.advance();
 313 │             path.push(name);
 314 │             while self.peek() == Some(&Token::Dot) {
 315 │                 self.advance();
 316 │                 if let Some(Token::Ident(next)) = self.peek().cloned() {
 317 │                     self.advance();
 318 │                     path.push(next);
 319 │                 } else {
 320 │                     break;
 321 │                 }
 322 │             }
 323 │         } else {
 324 │             return;
 325 │         }
 326 │ 
 327 │         self.skip_newlines();
 328 │ 
 329 │         let mut child_fields = Vec::new();
 330 │         let mut child_spans = Spans::new();
 331 │         while self.current_depth() == depth + 1 {
 332 │             self.parse_statement(&mut child_fields, &mut child_spans, depth + 1);
 333 │             self.skip_comments_and_newlines();
 334 │         }
 335 │ 
 336 │         let entry = if child_fields.is_empty() {
 337 │             Value::Null
 338 │         } else {
 339 │             Value::Object(child_fields)
 340 │         };
 341 │ 
 342 │         let (prefix, last) = path.split_at(path.len() - 1);
 343 │         let last = &last[0];
 344 │ 
 345 │         let mut temp_spans = Spans::new();
 346 │         let mut current_fields = fields;
 347 │         let mut current_spans: &mut Spans = spans;
 348 │         for segment in prefix {
 349 │             if !current_fields.iter().any(|(k, _)| k == segment) {
 350 │                 current_fields.push((segment.clone(), Value::Object(Vec::new())));
 351 │             }
 352 │             let existing = current_fields
 353 │                 .iter_mut()
 354 │                 .find(|(k, _)| k == segment)
 355 │                 .unwrap();
 356 │             if let Value::Object(ref mut inner) = existing.1 {
 357 │                 current_fields = inner;
 358 │                 current_spans = &mut temp_spans;
 359 │             } else {
 360 │                 let current_source = self.get_source_line(tilde_line).to_string();
 361 │                 let tilde_len: usize =
 362 │                     path.iter().map(std::string::String::len).sum::<usize>() + path.len();
 363 │                 let error = self.format_error(
 364 │                     "type-conflict",
 365 │                     &format!("'{segment}' is not an object"),
 366 │                     &[(
 367 │                         tilde_line,
 368 │                         tilde_col,
 369 │                         &current_source,
 370 │                         tilde_len,
 371 │                         Some("append attempted here"),
 372 │                     )],
 373 │                 );
 374 │                 self.errors.push(error);
 375 │                 return;
 376 │             }
 377 │         }
 378 │ 
 379 │         if let Some(existing) = current_fields.iter_mut().find(|(k, _)| k == last) {
 380 │             if let Value::Array(ref mut arr) = existing.1 {
 381 │                 arr.push(entry);
 382 │             } else {
 383 │                 let current_source = self.get_source_line(tilde_line).to_string();
 384 │                 let tilde_len: usize =
 385 │                     path.iter().map(std::string::String::len).sum::<usize>() + path.len();
 386 │                 let error = if let Some((first_line, first_col, first_source)) =
 387 │                     current_spans.get(last).cloned()
 388 │                 {
 389 │                     self.format_error(
 390 │                         "type-conflict",
 391 │                         &format!("'{last}' is not an array"),
 392 │                         &[
 393 │                             (
 394 │                                 first_line,
 395 │                                 first_col,
 396 │                                 first_source.as_str(),
 397 │                                 last.len(),
 398 │                                 Some("first defined here as scalar"),
 399 │                             ),
 400 │                             (
 401 │                                 tilde_line,
 402 │                                 tilde_col,
 403 │                                 &current_source,
 404 │                                 tilde_len,
 405 │                                 Some("append attempted here"),
 406 │                             ),
 407 │                         ],
 408 │                     )
 409 │                 } else {
 410 │                     self.format_error(
 411 │                         "type-conflict",
 412 │                         &format!("'{last}' is not an array"),
 413 │                         &[(
 414 │                             tilde_line,
 415 │                             tilde_col,
 416 │                             &current_source,
 417 │                             tilde_len,
 418 │                             Some("append attempted here"),
 419 │                         )],
 420 │                     )
 421 │                 };
 422 │                 self.errors.push(error);
 423 │             }
 424 │         } else {
 425 │             current_fields.push((last.clone(), Value::Array(vec![entry])));
 426 │         }
 427 │     }
 428 │ 
 429 │     #[allow(clippy::missing_errors_doc)]
 430 │     pub fn parse(&mut self) -> Result<Value, Vec<String>> {
 431 │         let mut fields: Vec<(String, Value)> = Vec::new();
 432 │         let mut spans = Spans::new();
 433 │ 
 434 │         if let Some((Token::Unknown(c), line, col)) = self
 435 │             .tokens
 436 │             .iter()
 437 │             .find(|(t, _, _)| matches!(t, Token::Unknown(_)))
 438 │         {
 439 │             let source = self.get_source_line(*line).to_string();
 440 │             let error = self.format_error(
 441 │                 "unexpected-character",
 442 │                 &format!("unexpected character '{c}', is this a Spine file?"),
 443 │                 &[(*line, *col, &source, 1, None)],
 444 │             );
 445 │             self.errors.push(error);
 446 │         }
 447 │ 
 448 │         if let Some((Token::Error(msg), line, col)) = self
 449 │             .tokens
 450 │             .iter()
 451 │             .find(|(t, _, _)| matches!(t, Token::Error(_)))
 452 │         {
 453 │             let source = self.get_source_line(*line).to_string();
 454 │             let error = self.format_error("lexer-error", msg, &[(*line, *col, &source, 1, None)]);
 455 │             self.errors.push(error);
 456 │         }
 457 │ 
 458 │         self.skip_comments_and_newlines();
 459 │ 
 460 │         while self.peek().is_some() {
 461 │             self.parse_statement(&mut fields, &mut spans, 0);
 462 │             self.skip_comments_and_newlines();
 463 │         }
 464 │ 
 465 │         if self.errors.is_empty() {
 466 │             Ok(Value::Object(fields))
 467 │         } else {
 468 │             Err(self.errors.clone())
 469 │         }
 470 │     }
