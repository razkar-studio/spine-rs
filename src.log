 114 │ pub unsafe extern "C" fn spine_doc_root(doc: *const SpineDoc) -> *const SpineValue {
 115 │     if doc.is_null() {
 116 │         return std::ptr::null();
 117 │     }
 118 │     unsafe { &(*doc).root }
 119 │         .as_ref()
 120 │         .map_or(std::ptr::null(), |value| {
 121 │             Box::into_raw(Box::new(SpineValue {
 122 │                 inner: std::ptr::from_ref::<Value>(value),
 123 │             }))
 124 │         })
 125 │ }
