 199 │             assert_eq!(
 200 │                 inner[4].1,
 201 │                 Value::String("2026-05-26T00:00:00Z".to_string())
 202 │             );
 203 │         } else {
 204 │             panic!("expected inner object");
 205 │         }
 206 │     } else {
 207 │         panic!("expected object");
 208 │     }
 209 │ }
