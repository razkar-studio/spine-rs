 193 │ #[unsafe(no_mangle)]
 194 │ pub unsafe extern "C" fn spine_value_tag(val: *const SpineValue) -> *mut c_char {
 195 │     if val.is_null() {
 196 │         return std::ptr::null_mut();
 197 │     }
 198 │     match unsafe { &*(*val).inner } {
 199 │         Value::Tagged(tag, _) => {
 200 │             CString::new(tag.as_str()).map_or(std::ptr::null_mut(), CString::into_raw)
 201 │         }
 202 │         _ => std::ptr::null_mut(),
