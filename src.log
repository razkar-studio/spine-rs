 333 │     #[allow(clippy::missing_panics_doc)]
 334 │     pub fn tokenize(&mut self) -> Vec<SpannedToken> {
 335 │         let mut tokens = Vec::new();
 336 │ 
 337 │         while !self.is_at_end() {
 338 │             let line = self.line;
 339 │             let col = self.col;
 340 │             match self.peek().unwrap() {
 341 │                 ' ' | '\t' => {
 342 │                     self.advance();
 343 │                     continue;
 344 │                 }
 345 │                 '\n' => {
 346 │                     self.after_value_start = false;
 347 │                     tokens.push((Token::Newline, line, col));
 348 │                     self.advance();
 349 │                     self.line_pipes = 0;
 350 │                     let mut lookahead = self.pos;
 351 │                     while let Some(&c) = self.input.get(lookahead) {
 352 │                         match c {
 353 │                             '|' => {
 354 │                                 self.line_pipes += 1;
 355 │                                 lookahead += 1;
 356 │                             }
 357 │                             ' ' | '\t' => {
 358 │                                 lookahead += 1;
 359 │                             }
 360 │                             _ => break,
 361 │                         }
 362 │                     }
 363 │                 }
 364 │                 '|' => {
 365 │                     self.line_pipes += 1;
 366 │                     tokens.push((Token::Pipe, line, col));
 367 │                     self.advance();
 368 │                 }
 369 │                 '=' => {
 370 │                     self.after_value_start = true;
 371 │                     tokens.push((Token::Equals, line, col));
 372 │                     self.advance();
 373 │                 }
 374 │                 '~' => {
 375 │                     tokens.push((Token::Tilde, line, col));
 376 │                     self.advance();
 377 │                 }
 378 │                 '-' => {
 379 │                     tokens.push((Token::Dash, line, col));
 380 │                     self.advance();
 381 │                     self.after_value_start = true;
 382 │                 }
 383 │                 '.' => {
 384 │                     tokens.push((Token::Dot, line, col));
 385 │                     self.advance();
 386 │                 }
 387 │                 '#' => tokens.push((self.skip_line_comment(), line, col)),
 388 │                 '/' => {
 389 │                     if self.input.get(self.pos + 1).copied() == Some('*') {
 390 │                         tokens.push((self.skip_block_comment(), line, col));
 391 │                     } else {
 392 │                         tokens.push((self.lex_ident_or_keyword(), line, col));
 393 │                     }
 394 │                 }
 395 │                 '"' => tokens.push((self.lex_string(), line, col)),
 396 │                 c if c.is_ascii_digit() => tokens.push((self.lex_number(), line, col)),
 397 │                 c if c.is_alphabetic() || c == '_' => {
 398 │                     tokens.push((self.lex_ident_or_keyword(), line, col));
 399 │                 }
 400 │                 _ => {
 401 │                     let c = self.peek().unwrap();
 402 │                     self.advance();
 403 │                     tokens.push((Token::Unknown(c), line, col));
 404 │                 }
 405 │             }
 406 │         }
 407 │ 
 408 │         tokens
 409 │     }
 410 │ }
 411 │ 
 412 │ fn strip_leading_pipes(line: &str, depth: usize) -> String {
 413 │     let mut chars = line.chars().peekable();
 414 │     let mut stripped = 0;
 415 │     while stripped < depth {
 416 │         match chars.peek() {
 417 │             Some(' ' | '\t') => {
 418 │                 chars.next();
 419 │             }
 420 │             Some('|') => {
 421 │                 chars.next();
 422 │                 stripped += 1;
 423 │             }
 424 │             _ => break,
 425 │         }
 426 │     }
 427 │     if chars.peek() == Some(&' ') {
 428 │         chars.next();
 429 │     }
 430 │     chars.collect()
 431 │ }
