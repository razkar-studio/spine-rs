 127 │ /// # Safety
 128 │ ///
 129 │ /// `val` must be a valid pointer to a `SpineValue` or null.
 130 │ #[unsafe(no_mangle)]
 131 │ pub const unsafe extern "C" fn spine_value_type(val: *const SpineValue) -> c_int {
 132 │     if val.is_null() {
 133 │         return -1;
 134 │     }
 135 │     match unsafe { &*(*val).inner } {
 136 │         Value::Null => 0,
 137 │         Value::Bool(_) => 1,
 138 │         Value::Number(_) => 2,
 139 │         Value::String(_) => 3,
 140 │         Value::Array(_) => 4,
 141 │         Value::Object(_) => 5,
 142 │         Value::Tagged(_, _) => 6,
 143 │     }
 144 │ }
