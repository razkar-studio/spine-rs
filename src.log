 211 │     if val.is_null() {
 212 │         return std::ptr::null_mut();
 213 │     }
 214 │     match unsafe { &*(*val).inner } {
 215 │         Value::Tagged(_, content) => {
 216 │             CString::new(content.as_str()).map_or(std::ptr::null_mut(), CString::into_raw)
 217 │         }
 218 │         _ => std::ptr::null_mut(),
 219 │     }
