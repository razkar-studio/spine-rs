 180 │         return std::ptr::null_mut();
 181 │     }
 182 │     match unsafe { &*(*val).inner } {
 183 │         Value::String(s) => {
 184 │             CString::new(s.as_str()).map_or(std::ptr::null_mut(), CString::into_raw)
 185 │         }
 186 │         _ => std::ptr::null_mut(),
 187 │     }
 188 │ }
