 164 │ pub const unsafe extern "C" fn spine_value_number(val: *const SpineValue) -> c_double {
 165 │     if val.is_null() {
 166 │         return 0.0;
 167 │     }
 168 │     match unsafe { &*(*val).inner } {
 169 │         Value::Number(n) => *n,
 170 │         _ => 0.0,
 171 │     }
