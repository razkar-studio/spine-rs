 150 │ pub const unsafe extern "C" fn spine_value_bool(val: *const SpineValue) -> bool {
 151 │     if val.is_null() {
 152 │         return false;
 153 │     }
 154 │     match unsafe { &*(*val).inner } {
 155 │         Value::Bool(b) => *b,
 156 │         _ => false,
 157 │     }
 158 │ }
