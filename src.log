  43 │     fn peek(&self) -> Option<&Token> {
  44 │         self.tokens.get(self.pos).map(|(t, _, _)| t)
  45 │     }
  46 │ 
  47 │     fn peek_span(&self) -> Option<(usize, usize)> {
  48 │         self.tokens.get(self.pos).map(|(_, l, c)| (*l, *c))
  49 │     }
  50 │ 
  51 │     fn advance(&mut self) -> Option<&Token> {
  52 │         let t = self.tokens.get(self.pos).map(|(t, _, _)| t);
  53 │         self.pos += 1;
  54 │         t
  55 │     }
