 473 │ 
 474 │     fn format_error(
 475 │         &self,
 476 │         kind: &str,
 477 │         message: &str,
 478 │         lines: &[(usize, usize, &str, usize, Option<&str>)],
 479 │     ) -> String {
 480 │         let filename = self.source.as_deref().unwrap_or("<input>");
 481 │ 
 482 │         let mut out = String::new();
 483 │ 
 484 │         out += &color_fmt!("[dim]┌─[/] [bold red]error[/red]: {}\n", kind);
 485 │         out += &color_fmt!("[dim]│[/]  [cyan]-->[/] {}\n", filename);
 486 │ 
 487 │         for (line, col, source_line, token_len, note) in lines {
 488 │             let gutter = format!("{line}:{col}");
 489 │ 
 490 │             out += &color_fmt!("[dim]├─[/] [cyan]{}[/] {}\n", gutter, source_line);
 491 │ 
 492 │             let start = col.saturating_sub(1);
 493 │             let mut caret_line = String::new();
 494 │             let gutter_width = UnicodeWidthStr::width(gutter.as_str());
 495 │             caret_line.push_str(&" ".repeat(gutter_width + 1));
 496 │             let prefix_chars = source_line.chars().take(start).count();
 497 │             caret_line.push_str(&" ".repeat(prefix_chars));
 498 │             caret_line.push_str(&"^".repeat(*token_len.max(&1)));
 499 │ 
 500 │             if let Some(note_text) = note {
 501 │                 out += &color_fmt!("[dim]│[/]  [red]{} {}[/]\n", caret_line, note_text);
 502 │             } else {
 503 │                 out += &color_fmt!("[dim]│[/]  [red]{}[/]\n", caret_line);
 504 │             }
 505 │         }
 506 │ 
 507 │         out += &color_fmt!("[dim]└─[/] [bold]{}\n\n", message);
 508 │ 
 509 │         out
 510 │     }
 511 │ 
 512 │     fn merge_into(
 513 │         &mut self,
 514 │         fields: &mut Vec<(String, Value)>,
 515 │         spans: &mut Spans,
 516 │         key: String,
 517 │         value: Value,
 518 │         line: usize,
 519 │         col: usize,
 520 │         debug_depth: usize, // temporary
 521 │     ) {
 522 │         if let Some(existing) = fields.iter_mut().find(|(k, _)| k == &key) {
 523 │             eprintln!(
 524 │                 "DEBUG: duplicate-key for key '{}', existing keys in this spans map: {:?}",
 525 │                 key,
 526 │                 spans.keys().collect::<Vec<_>>()
 527 │             );
 528 │             eprintln!(
 529 │                 "DEBUG: spans ptr={:p}, keys={:?}",
 530 │                 spans as *const _,
 531 │                 spans.keys().collect::<Vec<_>>()
 532 │             );
 533 │             eprintln!(
 534 │                 "DEBUG: depth={debug_depth} key='{key}' spans_ptr={:p}",
 535 │                 spans as *const _
 536 │             );
 537 │             eprintln!("{}", std::backtrace::Backtrace::capture());
 538 │             match (std::mem::take(&mut existing.1), value) {
 539 │                 (Value::Object(mut a), Value::Object(b)) => {
 540 │                     for (k, v) in b {
 541 │                         let mut merge_spans = Spans::new();
 542 │                         self.merge_into(&mut a, &mut merge_spans, k, v, line, col, debug_depth + 1);
 543 │                     }
 544 │                     existing.1 = Value::Object(a);
 545 │                 }
 546 │                 (old, new) => {
 547 │                     existing.1 = old;
 548 │                     let current_source = self.get_source_line(line).to_string();
 549 │                     let token_len = key.len();
 550 │ 
 551 │                     let is_type_conflict = matches!(
 552 │                         (&existing.1, &new),
 553 │                         (Value::Object(_), _) | (_, Value::Object(_))
 554 │                     );
 555 │ 
 556 │                     let (kind, message) = if is_type_conflict {
 557 │                         (
 558 │                             "type-conflict",
 559 │                             format!("'{key}' cannot be both a scalar and an object"),
 560 │                         )
 561 │                     } else {
 562 │                         ("duplicate-key", format!("'{key}' was already defined"))
 563 │                     };
 564 │ 
 565 │                     let error = if let Some((first_line, first_col, first_source)) =
 566 │                         spans.get(&key).cloned()
 567 │                     {
 568 │                         self.format_error(
 569 │                             kind,
 570 │                             &message,
 571 │                             &[
 572 │                                 (
 573 │                                     first_line,
 574 │                                     first_col,
 575 │                                     first_source.as_str(),
 576 │                                     token_len,
 577 │                                     Some("first defined here"),
 578 │                                 ),
 579 │                                 (
 580 │                                     line,
 581 │                                     col,
 582 │                                     &current_source,
 583 │                                     token_len,
 584 │                                     Some("redefined here"),
 585 │                                 ),
 586 │                             ],
 587 │                         )
 588 │                     } else {
 589 │                         self.format_error(
 590 │                             kind,
 591 │                             &message,
 592 │                             &[(
 593 │                                 line,
 594 │                                 col,
 595 │                                 &current_source,
 596 │                                 token_len,
 597 │                                 Some("redefined here"),
 598 │                             )],
 599 │                         )
 600 │                     };
 601 │                     self.errors.push(error);
 602 │                 }
 603 │             }
 604 │         } else {
 605 │             let source_line = self.get_source_line(line).to_string();
 606 │             spans.insert(key.clone(), (line, col, source_line));
 607 │             fields.push((key, value));
 608 │         }
 609 │     }
 610 │ }
